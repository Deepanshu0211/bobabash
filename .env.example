# Copy this file to .env.local (local) and add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or the "Connect" dialog)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_…) or the legacy "anon" key. Never the service_role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact origin of the site, no trailing slash. Used for the magic-link email redirect.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: an HTTPS link to your community (Slack, Discord…). Leave empty to hide it.
NEXT_PUBLIC_COMMUNITY_URL=

# ── Direct entry (no sign-in email) ──
# Supabase → Project Settings → API → service_role / secret key. SERVER ONLY: never add NEXT_PUBLIC_.
# When set, a registered email enters the portal directly. Anyone who knows that email can do the same.
SUPABASE_SERVICE_ROLE_KEY=
# Team access code: volunteer and organizer emails are asked for it after typing their email. If empty, volunteers
# enter with their email alone and organizers get an email link instead.
ORGANIZER_ACCESS_CODE=
# Optional: one code for everyone, e.g. announced at the venue. Leave empty for email-only entry.
EVENT_ACCESS_CODE=
# Participants sign in with a 6-digit code emailed by Supabase ("on" to enable). Needs custom SMTP in
# Supabase (Auth → SMTP) and {{ .Token }} in the Magic Link email template. Off: email-only entry.
PARTICIPANT_EMAIL_CODE=
# The app sends the code email itself through Brevo (Brevo → SMTP & API → SMTP). SERVER ONLY.
# Without these, Supabase sends its own email template instead.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_FROM=
